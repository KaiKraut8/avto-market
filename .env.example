APP_NAME="KAI Garage"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# KAI_DB_* rather than DB_*: the dev container exports DB_* for the legacy site (see config/database.php)
KAI_DB_CONNECTION=mysql
KAI_DB_HOST=db
KAI_DB_PORT=3306
KAI_DB_DATABASE=kai
KAI_DB_USERNAME=app
KAI_DB_PASSWORD=secret
LEGACY_DB_DATABASE=app

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# must differ from the legacy site's "kai_session" cookie while both run on localhost
SESSION_COOKIE=kai_laravel_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Payments: add a Mollie API key (test_... or live_...) from https://my.mollie.com; empty = local test payments
MOLLIE_KEY=
# for the admin balance and withdrawals: Mollie access token with balances.read, payouts.read, payouts.write
MOLLIE_ACCESS_TOKEN=

# the chat assistant (config/assistant.php): a model on an Ollama server, or Claude, or built-in answers
ASSISTANT_DRIVER=auto
OLLAMA_URL=
OLLAMA_MODEL=qwen3:30b-a3b
OLLAMA_TIMEOUT=45
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
